@dataclasses.dataclass(frozen=True, slots=True)
class GuestArtifacts:
    """Describe persistent boot artifacts prepared for the Alpine guest."""

    kernel_path: Path
    initramfs_path: Path
    usr_squashfs_path: Path

    @property
    def prepare_marker_path(self) -> Path:
        """Return the prepare recipe version marker path."""
        return self.kernel_path.parent / "prepare-recipe-version"

    @property
    def lock_path(self) -> Path:
        """Return the lock path serializing artifact preparation across processes."""
        return self.kernel_path.parent / PREPARE_LOCK_FILENAME

    @property
    def session_lock_path(self) -> Path:
        """Return the lock path sessions hold shared while these artifacts are in use."""
        return self.kernel_path.parent / SESSION_LOCK_FILENAME


