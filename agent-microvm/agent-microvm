@dataclasses.dataclass(frozen=True, slots=True)
class VirtiofsShare:
    """Describe one host directory exported to the guest with virtio-fs."""

    tag: str
    source: Path
    socket_path: Path
    readonly: bool

    @property
    def chardev_id(self) -> str:
        """Return the QEMU chardev identifier for this share."""
        return f"char-{self.tag}"


@dataclasses.dataclass(frozen=True, slots=True)
class CpuTopology:
    """Guest processor layout for QEMU -smp."""

    sockets: int
    cores: int
    threads: int
    # Host CPU index per guest vCPU, or None to leave vCPUs unpinned.
    pin: tuple[int, ...] | None = None

    @property
    def qemu_smp(self) -> str:
        """Return the QEMU -smp value describing this layout."""
        cpus = self.sockets * self.cores * self.threads
        return (
            f"cpus={cpus},sockets={self.sockets}"
            f",cores={self.cores},threads={self.threads}"
        )


@dataclasses.dataclass(frozen=True, slots=True)
class MicrovmConfig:
