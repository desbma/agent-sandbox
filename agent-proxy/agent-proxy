#!/usr/bin/env python3

"""Auth-injecting proxy backend for the coding-agent sandbox."""

from __future__ import annotations

import asyncio
import functools
import os
import re
import socket
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    import collections.abc

    from mitmproxy import addonmanager, http  # ty: ignore[unresolved-import]

GITHUB_API_HOST = "api.github.com"
ALLOW_HOSTS = rf"^{re.escape(GITHUB_API_HOST)}:443$"
LISTEN_HOST = "127.0.0.1"
LISTEN_PORT = "8085"
SYSTEM_CA_BUNDLE = Path("/etc/ssl/certs/ca-certificates.crt")
DATA_DIR = (
    Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "agent-proxy"
)
CA_CERT = DATA_DIR / "mitmproxy-ca-cert.pem"
# upstream connections: keepalive probe timing, and delay before aborting on unacknowledged data
KEEPALIVE_IDLE_SECONDS = 30
KEEPALIVE_INTERVAL_SECONDS = 10
UNACKNOWLEDGED_TIMEOUT_SECONDS = 60

type Streams = tuple[asyncio.StreamReader, asyncio.StreamWriter]


@functools.cache
def github_token() -> str:
    """Read the GitHub token from the systemd credential directory."""
    return (
        (Path(os.environ["CREDENTIALS_DIRECTORY"]) / "github_token").read_text().strip()
    )


def with_dead_peer_detection[**P](
    open_connection: collections.abc.Callable[P, collections.abc.Awaitable[Streams]],
) -> collections.abc.Callable[P, collections.abc.Awaitable[Streams]]:
    """Wrap a TCP connection opener to abort its connections once the peer stops acknowledging, even while idle."""

    async def open_bounded_connection(*args: P.args, **kwargs: P.kwargs) -> Streams:
        """Open a connection and enable keepalive probes and the unacknowledged data timeout on it."""
        reader, writer = await open_connection(*args, **kwargs)
        sock = writer.get_extra_info("socket")
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, KEEPALIVE_IDLE_SECONDS)
        sock.setsockopt(
            socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, KEEPALIVE_INTERVAL_SECONDS
        )
        sock.setsockopt(
            socket.IPPROTO_TCP,
            socket.TCP_USER_TIMEOUT,
            UNACKNOWLEDGED_TIMEOUT_SECONDS * 1000,
        )
        return reader, writer

    return open_bounded_connection


def load(_loader: addonmanager.Loader) -> None:
    """Make the upstream connections mitmproxy opens detect a silently dead peer (mitmproxy hook)."""
    # ty types a module's function attribute as that very function, which no wrapper can match
    asyncio.open_connection = with_dead_peer_detection(  # ty: ignore[invalid-assignment]
        asyncio.streams.open_connection
    )


def running() -> None:
    """Publish the combined CA bundle once mitmproxy's CA exists (mitmproxy hook)."""
    bundle = Path(os.environ["RUNTIME_DIRECTORY"]) / "ca-bundle.crt"
    bundle.write_bytes(SYSTEM_CA_BUNDLE.read_bytes() + b"\n" + CA_CERT.read_bytes())


def request(flow: http.HTTPFlow) -> None:
    """Inject the token on requests whose upstream is the GitHub API (mitmproxy hook)."""
    address = flow.server_conn.address
    if address is not None and address[0] == GITHUB_API_HOST:
        flow.request.headers["authorization"] = f"Bearer {github_token()}"


def main() -> None:
    """Replace this process with mitmdump running as the proxy, loading this module."""
    os.execvp(
        "mitmdump",
        [
            "mitmdump",
            "-q",
            "--listen-host",
            LISTEN_HOST,
            "--listen-port",
            LISTEN_PORT,
            "--set",
            f"confdir={DATA_DIR}",
            "--set",
            "connection_strategy=lazy",
            "--allow-hosts",
            ALLOW_HOSTS,
            "-s",
            str(Path(__file__).resolve()),
        ],
    )


if __name__ == "__main__":
    main()
