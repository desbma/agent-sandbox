class UnsatisfiableError(Exception):
    """Constraint of a request that a harness cannot satisfy."""


@dataclasses.dataclass(frozen=True)
class Selection:
    """Set of names of what a harness loads or enables: an explicit one, or the harness's own adjusted by additions and removals, along with optional names a harness adds only if it has them."""

    names: frozenset[str] | None
    added: frozenset[str] = frozenset()
    optional: frozenset[str] = frozenset()
    removed: frozenset[str] = frozenset()

    @property
    def mentioned(self) -> frozenset[str]:
        """Names the selection lists, adds, optionally adds or removes."""
        return (self.names or frozenset()) | self.added | self.optional | self.removed

    def adjust(
        self,
        *,
        added: frozenset[str] = frozenset(),
        optional: frozenset[str] = frozenset(),
        removed: frozenset[str] = frozenset(),
    ) -> Self:
        """Add, optionally add and remove names, removals winning over additions, and additions over optional ones."""
        added -= removed
        optional -= added | removed
        changed = added | optional | removed
        if self.names is not None:
            return dataclasses.replace(
                self,
                names=(self.names - changed) | added,
                optional=(self.optional - changed) | optional,
            )
        return dataclasses.replace(
            self,
            added=(self.added - changed) | added,
            optional=(self.optional - changed) | optional,
            removed=(self.removed - changed) | removed,
        )

    def resolve_optional(self, available: Container[str]) -> Self:
        """Add the optional names a harness has, and drop the others."""
        return dataclasses.replace(self, optional=frozenset()).adjust(
            added=frozenset(name for name in self.optional if name in available)
        )


