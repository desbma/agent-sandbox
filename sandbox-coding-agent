        if (mount := binary_mount(binary, layout)) is not None
    ]
    mounts = resolve_mounts([*layout, *binary_mounts], CWD)

    dir_mounts: dict[MountKind, list[Path]] = collections.defaultdict(list)
    for mount in mounts:
        policy = mount.kind.spec.source_policy
        if (policy is not SourcePolicy.NO_SOURCE) and not mount.src.exists():
            if policy is SourcePolicy.DROP_IF_MISSING:
                continue
            mount.create_source()
        bwrap_args += mount.bwrap_args
        if (policy is SourcePolicy.NO_SOURCE) or mount.src.is_dir():
            dir_mounts[mount.kind].append(mount.target)

