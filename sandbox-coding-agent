#!/usr/bin/env -S python3 -S

"""Run coding agent in tight bubblewrap sandbox."""

#
# Note: To use KVM in guest, we need have write access to /dev/kvm, without the kvm group,
# because bubblewrap does not support supplementary groups, and changing the primary group would
# probably break other stuff (for example when the guest creates files).
# Setup with:
# printf 'KERNEL=="kvm", OWNER:="%s", GROUP:="kvm", MODE:="0660"\n' "$USER" | sudo tee /etc/udev/rules.d/99-local-kvm-owner.rules >/dev/null && sudo udevadm control --reload-rules && sudo udevadm trigger --name-match=kvm
# Test in guest with:
# printf 'info kvm\nquit\n' | qemu-system-x86_64 -accel kvm -machine none -nodefaults -display none -serial none -monitor stdio -S
#

import collections.abc
import contextlib
import dataclasses
import enum
import grp
import os
import pwd
import re
import shlex
import shutil
import string
import subprocess
import sys
import tempfile
import typing
from pathlib import Path


class SourcePolicy(enum.Enum):
    """Launcher-side handling of the host path a mount kind draws from.

    Covers the launcher side only, and says nothing of the mount points bwrap itself
    creates in the sandbox.
    """

    # the mount's src field carries the target, not a host source
    NO_SOURCE = enum.auto()
    DROP_IF_MISSING = enum.auto()
    CREATE_IF_MISSING = enum.auto()


@dataclasses.dataclass(frozen=True, slots=True)
class MountSpec:
    """Everything needed to realize one kind of mount in the sandbox."""

    bwrap_args: tuple[str, ...]
    agent_description: str
    source_policy: SourcePolicy = SourcePolicy.DROP_IF_MISSING


class MountKind(enum.Enum):
    """Sandbox mount kinds in instructions display order."""

    TMPFS = MountSpec(
        ("--perms", "0700", "--tmpfs", "{dst}"),
        "tmpfs filesystems (paths under these can not be accessed outside of the sandbox by the user, unless under a deeper mount point; they may also be cleared if the agent is restarted)",
        SourcePolicy.NO_SOURCE,
    )
    OVERLAYFS = MountSpec(
        ("--dir", "{dst}", "--overlay-src", "{src}", "--tmp-overlay", "{dst}"),
        "overlayfs filesystems (your sandbox inherits their content on startup, but changes are not reflected outside of the sandbox)",
    )
    BIND_RO = MountSpec(
        ("--ro-bind", "{src}", "{dst}"),
        "read-only bind mounts",
    )
    BIND_RW = MountSpec(
        ("--bind", "{src}", "{dst}"),
        "normal bind mounts (allowing writes, reflected outside of the sandbox)",
        SourcePolicy.CREATE_IF_MISSING,
    )

    @property
    def spec(self) -> MountSpec:
        """Return the kind's specification."""
        assert isinstance(self.value, MountSpec)
        return self.value


@dataclasses.dataclass(frozen=True, slots=True)
class Mount:
    """One mount in the sandbox, at its source path unless dst remaps it."""

    src: Path
    kind: MountKind
    dst: Path | None = None

    @property
    def target(self) -> Path:
        """Return the path the mount appears at inside the sandbox."""
        return self.dst or self.src

    @property
    def bwrap_args(self) -> list[str]:
        """Return the bwrap arguments exposing the mount in the sandbox."""
        return [
            arg.format(src=self.src, dst=self.target)
            for arg in self.kind.spec.bwrap_args
        ]

    def create_source(self) -> None:
        """Create the missing host source, tolerating a launcher that raced to create it."""
        self.src.mkdir(parents=True, exist_ok=True)


@dataclasses.dataclass(frozen=True, slots=True)
class File:
    """Generated file content exposed read-only in the sandbox."""

    data: bytes
    executable: bool = False


@dataclasses.dataclass(frozen=True, slots=True)
class LinkedCredentials:
    """Credentials file inside an agent's state dir, with the dir's other entries."""

    state_dir: Mount
    # credentials file name in the state dir
    name: str
    # names of the other files and of the dirs the agent keeps in the state dir, the only
    # entries persisted under an auth profile
    files: tuple[str, ...]
    dirs: tuple[str, ...]

    @property
    def src(self) -> Path:
        """Return the host path of the default credentials file."""
        return self.state_dir.src / self.name


@dataclasses.dataclass(frozen=True, slots=True)
class AgentSpec:
    """Sandbox provisioning specific to a coding agent, empty for an unknown one."""

    # global instructions file, None when the agent does not read one from a known path
    agents_md: Path | None = None
    # sandbox dir holding the agent's session history, None when it keeps none
    session_dir: Path | None = None
    # credentials file, None for agents without auth profile support
    credentials: Mount | LinkedCredentials | None = None
    # arguments of the agent's own login command, None when it starts fine on empty credentials
    login_args: tuple[str, ...] | None = None
    mounts: tuple[Mount, ...] = ()
    # symlink target to link path
    symlinks: tuple[tuple[Path, Path], ...] = ()
    files: dict[Path, File] = dataclasses.field(default_factory=dict)
    env: dict[str, str] = dataclasses.field(default_factory=dict)
    # binary paths probed in order; a hit provisions this agent in the sandbox even when the
    # launched agent is another one
    provision_always: tuple[Path, ...] = ()


@dataclasses.dataclass(frozen=True, slots=True)
class RepoInfo:
    """VCS layout of the launch directory, resolved with a single jj or git query."""

    root: Path
    jj_default_ws_root: Path | None
    jj_workspace_roots: tuple[Path, ...] | None


@dataclasses.dataclass(frozen=True, slots=True)
class SandboxFacts:
    """Sandbox specifics worth describing to the agent in its generated instructions."""

    exchange_dir: Path | None
    review_dir: Path | None
    handoff_dir: Path | None
    dir_mounts: dict[MountKind, list[Path]]
    has_unjaild: bool
    has_proxy: bool
    # real jj, to point at when the read-only wrapper does not fit; None outside a jj workspace
    jj_bin: str | None


def resolve_jj() -> str | None:
    """Resolve the jj binary on PATH, skipping the sandbox wrapper that injects --ignore-working-copy."""
    # the wrapper already adds --ignore-working-copy; a second one is a hard jj error
    path = os.pathsep.join(
        entry for entry in os.get_exec_path() if Path(entry) != SANDBOX_BIN_DIR
    )
    return shutil.which("jj", path=path)


def run_capture(cmd: collections.abc.Sequence[str]) -> str | None:
    """Run a command and return its standard output, or None if it fails."""
    try:
        proc = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return proc.stdout


def jj_workspaces() -> dict[str, Path] | None:
    """Map each workspace name of the jj repo at the cwd to its root, or None outside jj."""
    if JJ_BIN is None:
        return None
    out = run_capture(
        [
            JJ_BIN,
            "--ignore-working-copy",
            "workspace",
            "list",
            "-T",
            'name ++ "\t" ++ root ++ "\n"',
        ],
    )
    if out is None:
        return None
    # jj before 0.46 lists a workspace deleted without being forgotten with an empty root
    return {
        name: Path(root)
        for name, root in (line.split("\t", 1) for line in out.splitlines())
        if root
    }


def git_toplevel() -> Path | None:
    """Return the git toplevel containing the cwd, or None outside a git repo."""
    out = run_capture(["git", "rev-parse", "--show-toplevel"])
    if out is None:
        return None
    return Path(out.strip())


def query_repo_info(cwd: Path) -> RepoInfo | None:
    """Resolve the VCS layout of cwd from a single jj or git query, or None outside any repo."""
    workspaces = jj_workspaces()
    if workspaces is not None:
        roots = tuple(workspaces.values())
        default = workspaces.get("default")
        current = max(
            (root for root in roots if cwd.is_relative_to(root)),
            key=lambda root: len(root.parts),
            default=cwd,
        )
        return RepoInfo(current, default, roots)
    git_root = git_toplevel()
    if git_root is not None:
        return RepoInfo(git_root, None, None)
    return None


def shared_workspace_root(cwd: Path, ws_roots: collections.abc.Sequence[Path]) -> Path:
    """Return the directory shared by a repo's workspace roots, or cwd if none or too scattered."""
    if not ws_roots:
        return cwd
    names = [str(root) for root in ws_roots]
    bare = min(names, key=len)
    # flat siblings such as proj and proj-ws1 share the bare project dir their names extend
    if all(name.startswith(bare) for name in names):
        shared = Path(bare)
    else:
        shared = Path(os.path.commonpath(ws_roots))
    current = max(
        (root for root in ws_roots if cwd.is_relative_to(root)),
        key=lambda root: len(root.parts),
        default=cwd,
    )
    # a prefix more than one level above the workspace means unrelated checkouts: do not share
    if len(current.parts) - len(shared.parts) >= SHARED_DIR_MAX_PREFIX_DEPTH_DELTA:
        return cwd
    return shared


def project_identity(cwd: Path, repo_info: RepoInfo | None) -> Path:
    """Return the directory identifying the project, shared by a repo's workspaces."""
    if repo_info is None:
        return cwd
    if repo_info.jj_workspace_roots is not None:
        return shared_workspace_root(cwd, repo_info.jj_workspace_roots)
    return repo_info.root


def project_slug(identity: Path) -> str:
    """Build the slug naming the project's shared dirs."""
    return "-".join(p.lower() for p in identity.relative_to("/").parts[-2:])


def session_tmpfs_mounts(specs: collections.abc.Iterable[AgentSpec]) -> list[Mount]:
    """Return the mounts keeping the agents' session history out of the host."""
    return [
        Mount(spec.session_dir, MountKind.TMPFS)
        for spec in specs
        if spec.session_dir is not None
    ]


def profile_credentials(credentials: Path, profile: str) -> Path:
    """Return the credentials file of an auth profile, creating it empty when the profile is new."""
    variant = credentials.with_stem(f"{credentials.stem}-{profile}")
    if not variant.exists():
        variant.parent.mkdir(parents=True, exist_ok=True)
        # seeding from another profile would put one refresh token in two files, and the first
        # rotation strands the one that did not refresh
        with tempfile.NamedTemporaryFile("w", dir=variant.parent) as seed:
            seed.write(EMPTY_CREDENTIALS)
            seed.flush()
            # a launcher racing on the same new profile either wins the link or keeps its own
            # credentials, and never sees a half written file
            with contextlib.suppress(FileExistsError):
                variant.hardlink_to(seed.name)
    return variant


def runs_login(
    launched_args: collections.abc.Sequence[str],
    login_args: collections.abc.Sequence[str],
) -> bool:
    """Return whether the launched arguments invoke the agent's login command."""
    # the PATH wrapper inserts the agent's own flags before the arguments it was called with
    return any(
        list(launched_args[index : index + len(login_args)]) == list(login_args)
        for index in range(len(launched_args))
    )


def linked_profile_spec(
    name: str, spec: AgentSpec, linked: LinkedCredentials, credentials: Path
) -> AgentSpec:
    """Return spec with its state dir moved aside and its entries exposed back, credentials as the profile's."""
    moved = LAUNCHER_RUN_DIR / f"{name}-state"
    link_dir = linked.state_dir.target
    mounts = (
        dataclasses.replace(linked.state_dir, dst=moved),
        # sandbox-private even when the launch dir bind spans it
        Mount(link_dir, MountKind.TMPFS),
        # bound rather than linked, an agent may reject a symlinked dir
        *(
            Mount(linked.state_dir.src / d, MountKind.BIND_RW, link_dir / d)
            for d in linked.dirs
        ),
    )
    links = (
        (moved / credentials.name, link_dir / linked.name),
        *((moved / file, link_dir / file) for file in linked.files),
    )
    return dataclasses.replace(
        spec,
        mounts=(*spec.mounts, *mounts),
        symlinks=(*spec.symlinks, *links),
    )


def auth_profile_var(agent: str) -> str:
    """Return the name of the env var selecting an agent's auth profile."""
    return f"SANDBOX_AGENT_{agent.upper()}_AUTH"


def apply_auth_profiles(
    agents: collections.abc.Mapping[str, AgentSpec],
    launched_agent: str,
    launched_args: collections.abc.Sequence[str],
) -> dict[str, AgentSpec]:
    """Return each agent's spec exposing the credentials of its selected auth profile, if any."""
    applied = dict(agents)
    for name, spec in agents.items():
        profile_var = auth_profile_var(name)
        profile = os.environ.get(profile_var)
        if profile is None:
            if isinstance(spec.credentials, LinkedCredentials):
                applied[name] = dataclasses.replace(
                    spec, mounts=(*spec.mounts, spec.credentials.state_dir)
                )
            continue
        if spec.credentials is None:
            fatal_error(f"Agent {name!r} does not support auth profiles")
        credentials = profile_credentials(spec.credentials.src, profile)
        empty = credentials.read_text() == EMPTY_CREDENTIALS
        login_args = spec.login_args
        if empty and (login_args is not None):
            logging_in = (name == launched_agent) and runs_login(
                launched_args, login_args
            )
            # the login is the command writing the credentials, anything else would start only
            # to reject them
            if not logging_in:
                # without the selector the login would land on the default credentials
                command = shlex.join([f"{profile_var}={profile}", name, *login_args])
                fatal_error(
                    f"{name.title()} auth profile {profile!r} is empty, run `{command}`"
                )
        if isinstance(spec.credentials, LinkedCredentials):
            applied[name] = linked_profile_spec(
                name, spec, spec.credentials, credentials
            )
        else:
            mount = dataclasses.replace(spec.credentials, src=credentials)
            applied[name] = dataclasses.replace(spec, mounts=(*spec.mounts, mount))
    return applied


def vcs_dirs(cwd: Path, repo_info: RepoInfo | None) -> list[Path]:
    """Return the VCS dirs to expose: cwd's, plus the jj default workspace's."""
    # below a repo root, cwd has no VCS dir of its own, and the repo's stay hidden
    if (repo_info is not None) and (repo_info.root != cwd):
        return []
    default_ws = repo_info.jj_default_ws_root if repo_info is not None else None
    roots = dict.fromkeys(root for root in (cwd, default_ws) if root is not None)
    return [root / subdir for root in roots for subdir in (".git", ".jj")]


def agent_binary_paths(
    agents: collections.abc.Iterable[str], extras: dict[str, Path]
) -> list[Path]:
    """Return the binary and ~/.local/bin wrapper of every agent provisioned in the sandbox."""
    entry_bin = shutil.which(sys.argv[1])
    assert entry_bin is not None
    wrappers = (HOME / ".local/bin" / name for name in agents)
    return [*wrappers, Path(entry_bin), *extras.values()]


def tool_paths() -> list[Path]:
    """Return executable paths for the selected host tools that are available."""
    tools = (shutil.which(tool_name) for tool_name in HOME_TOOLS)
    return [Path(tool) for tool in tools if tool is not None]


def already_exposed(path: Path, layout: collections.abc.Sequence[Mount]) -> bool:
    """Tell whether the sandbox layout shows the host path at its own location."""
    enclosing = [mount for mount in layout if path.is_relative_to(mount.target)]
    if not enclosing:
        return False
    # bwrap applies mounts in order, so the last of the deepest is what the path resolves to
    deepest = max(reversed(enclosing), key=lambda mount: len(mount.target.parts))
    return (deepest.kind.spec.source_policy is not SourcePolicy.NO_SOURCE) and (
        deepest.src == deepest.target
    )


def sandbox_dest(path: Path) -> Path | None:
    """Return where a sandbox symlink redirects a host path, or None when none does."""
    for target, link in SYMLINKS.items():
        if path.is_relative_to(link) and target.exists():
            return target / path.relative_to(link)
    return None


def binary_mount(binary: Path, layout: collections.abc.Sequence[Mount]) -> Mount | None:
    """Return a bind for an unexposed path in a host binary's link chain, if one exists."""
    path = binary
    seen: set[Path] = set()
    while path not in seen:
        seen.add(path)
        candidate = Mount(path, MountKind.BIND_RO, sandbox_dest(path))
        if not already_exposed(candidate.target, layout) or (
            candidate.dst is not None and candidate.target.resolve() != path.resolve()
        ):
            return candidate
        # the layout shows the path, which for a link is only as good as what it points to
        following = (
            Path(os.path.normpath(path.parent / path.readlink()))
            if path.is_symlink()
            else path.resolve()
        )
        if following == path:
            return None
        path = following
    # a cycle of links, which no bind can make resolve
    return None


def cargo_target_mounts() -> list[Mount]:
    """Return the mount keeping cargo build artifacts off the host, when the cwd is a crate."""
    if not (CWD / "Cargo.toml").is_file():
        return []
    target_dir = CWD / "target"
    target_dir.mkdir(exist_ok=True)
    return [Mount(target_dir, MountKind.OVERLAYFS)]


def resolve_mounts(raw: collections.abc.Iterable[Mount], cwd: Path) -> list[Mount]:
    """Deduplicate mounts and order them parents-first, keeping the launch dir writable.

    bwrap applies mounts in order, each shadowing the earlier ones it overlaps, so a child
    must follow its parent, and a read-only bind colliding with the cwd is dropped.
    """
    mounts = [
        mount
        for mount in dict.fromkeys(raw)
        if (mount.target != cwd) or (mount.kind is MountKind.BIND_RW)
    ]
    mounts.sort(key=lambda mount: (len(mount.target.parts), mount.target.parts))
    return mounts


def claude_path_hash(path: str) -> str:
    """Compute Claude Code's base36 path hash that disambiguates truncated slugs."""
    h = 0
    for char in path:
        h = (h << 5) - h + ord(char)
        h = ((h + 0x80000000) & 0xFFFFFFFF) - 0x80000000
    n = abs(h)
    out = ""
    while n:
        n, remainder = divmod(n, 36)
        out = BASE36_DIGITS[remainder] + out
    return out or "0"


def claude_project_slug(path: Path) -> str:
    """Encode a path the way Claude Code names its per-project state directory."""
    slug = re.sub(r"[^a-zA-Z0-9]", "-", str(path))
    if len(slug) <= CLAUDE_SLUG_MAX_LEN:
        return slug
    return f"{slug[:CLAUDE_SLUG_MAX_LEN]}-{claude_path_hash(str(path))}"


def claude_md_symlinks(cwd: Path) -> tuple[tuple[Path, Path], ...]:
    """Return the AGENTS.md to CLAUDE.md link pairs of cwd and its subdirectories."""
    # before Python 3.14, pathlib predicates raise PermissionError in an unsearchable dir
    dirs = [cwd]
    level = [cwd]
    for _ in range(CLAUDE_MD_MAX_DEPTH):
        children: list[Path] = []
        for d in level:
            with contextlib.suppress(PermissionError):
                # a symlinked dir resolves elsewhere in the sandbox, where the link cannot be created
                children += [
                    child
                    for child in d.iterdir()
                    if child.is_dir(follow_symlinks=False)
                ]
        level = children
        dirs += level
    pairs: list[tuple[Path, Path]] = []
    for d in dirs:
        agents_md = d / "AGENTS.md"
        claude_md = d / "CLAUDE.md"
        with contextlib.suppress(PermissionError):
            if agents_md.is_file() and not claude_md.exists(follow_symlinks=False):
                pairs.append((agents_md, claude_md))
    return tuple(pairs)


def show_message(msg: str) -> None:
    """Show a message prefixed with the launcher name."""
    sys.stderr.write(f"{Path(__file__).name}: {msg}\n")


def fatal_error(msg: str) -> typing.NoReturn:
    """Show an error message and exit."""
    show_message(msg)
    sys.exit(1)


def prompt_bool(msg: str, *, default: bool = False) -> bool:
    """Prompt the user with a boolean question."""
    if not sys.stdin.isatty():
        return default
    answers = {"": default, "y": True, "n": False}
    prompt = f"{Path(__file__).name}: {msg} [{'Y/n' if default else 'y/N'}] "
    while True:
        try:
            answer = input(prompt).strip().lower()
        except EOFError:
            return default
        if answer in answers:
            return answers[answer]


def confirm_cwd(repo_info: RepoInfo | None) -> Path:
    """Confirm startup directory if needed."""
    cwd = Path.cwd()
    if (
        (repo_info is not None)
        and (repo_info.root != cwd)
        and prompt_bool(
            f"Run in repo root {str(repo_info.root)!r} instead of {str(cwd)!r}?"
        )
    ):
        cwd = repo_info.root
    elif cwd in (Path.home(), Path("/")):
        fatal_error(f"Refusing to start in {str(cwd)!r}")
    return cwd


def memfd_data(data: bytes) -> int:
    """Generate a memfd with data written in it."""
    fd = os.memfd_create("", 0)
    os.write(fd, data)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def enter_network_namespace(pasta_args: list[str]) -> None:
    """Move this process into new user and network namespaces, and have pasta connect them to the host's network."""
    uid, gid = os.getuid(), os.getgid()
    ready, release = os.pipe()
    helper = os.fork()
    if helper == 0:
        # pasta starts from the host's namespaces, once this process has left them
        os.close(release)
        os.read(ready, 1)
        try:
            os.execv("/usr/bin/pasta", pasta_args)
        except FileNotFoundError:
            show_message("Missing /usr/bin/pasta: install passt, which provides it")
        os._exit(1)
    os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNET)
    Path("/proc/self/setgroups").write_text("deny")
    Path("/proc/self/uid_map").write_text(f"{uid} {uid} 1")
    Path("/proc/self/gid_map").write_text(f"{gid} {gid} 1")
    # unprivileged ICMP sockets, as the host's namespace usually allows
    Path("/proc/sys/net/ipv4/ping_group_range").write_text(f"{gid} {gid}")
    os.close(release)
    _, status = os.waitpid(helper, 0)
    if os.waitstatus_to_exitcode(status) != 0:
        fatal_error("Failed to set up the sandbox network")


def nss_entries[T](
    lookup: collections.abc.Callable[[str], T], names: list[str]
) -> list[T]:
    """Look up NSS entries by name, skipping the ones the host does not know."""
    entries = []
    for name in names:
        with contextlib.suppress(KeyError):
            entries.append(lookup(name))
    return entries


def gen_passwd(groups: list[str]) -> bytes:
    """Generate stripped down /etc/passwd file content."""
    uid = os.getuid()
    entries = [pwd.getpwuid(uid), *nss_entries(pwd.getpwnam, groups)]
    return "".join(
        f"{entry.pw_name}:{entry.pw_passwd}:{entry.pw_uid}:{entry.pw_gid}:{entry.pw_gecos}:{entry.pw_dir}:"
        f"{'/usr/bin/bash' if entry.pw_uid == uid else entry.pw_shell}\n"
        for entry in entries
    ).encode()


def gen_group(groups: list[str]) -> bytes:
    """Generate stripped down /etc/group file content."""
    entries = [grp.getgrgid(os.getgid()), *nss_entries(grp.getgrnam, groups)]
    return "".join(
        f"{entry.gr_name}:{entry.gr_passwd or ''}:{entry.gr_gid}:{','.join(entry.gr_mem)}\n"
        for entry in entries
    ).encode()


def parse_cpu_list(spec: str) -> list[int]:
    """Expand a sysfs CPU range list like "0-3,8,10-11" into individual indices."""
    cpus: list[int] = []
    for part in spec.split(","):
        if "-" in part:
            low, high = part.split("-")
            cpus.extend(range(int(low), int(high) + 1))
        else:
            cpus.append(int(part))
    return cpus


def gen_cpu_topology() -> bytes | None:
    """Encode the host socket/core/thread counts and vCPU pin map, or None if unreadable.

    A uniformly hyperthreaded host is mirrored so a guest core's threads bind to
    one host core's siblings; a heterogeneous host, inexpressible as a QEMU -smp
    grid, is reduced to one guest core bound to each host physical core.
    """
    online_path = SYS_CPU_DIR / "online"
    if not online_path.is_file():
        return None
    online_cpus = parse_cpu_list(online_path.read_text().strip())
    cores: dict[tuple[int, int], list[int]] = collections.defaultdict(list)
    for cpu in online_cpus:
        topology = SYS_CPU_DIR / f"cpu{cpu}/topology"
        package = int((topology / "physical_package_id").read_text())
        core = int((topology / "core_id").read_text())
        cores[(package, core)].append(cpu)
    sockets = len(set(package for package, _ in cores))
    cores_per_socket = len(cores) // sockets
    if len(set(len(siblings) for siblings in cores.values())) == 1:
        threads = len(online_cpus) // len(cores)
        pin = [cpu for key in sorted(cores) for cpu in sorted(cores[key])]
    else:
        threads = 1
        pin = [min(cores[key]) for key in sorted(cores)]
    counts = f"sockets={sockets},cores={cores_per_socket},threads={threads}"
    pin_line = ",".join(str(cpu) for cpu in pin)
    return f"{counts}\npin={pin_line}".encode()


def read_instructions(path: Path) -> str | None:
    """Return the stripped content of a user instructions file, or None if it does not exist."""
    try:
        return path.read_text().strip()
    except FileNotFoundError:
        return None


def gen_global_agents_md(agent: str, facts: SandboxFacts) -> bytes:
    """Generate the global AGENTS.md: the user's base and agent files plus the sandbox section."""
    filesystem_note = [
        "You have a different view of the filesystem than the user. Some notable mount points in your environment are:",
    ]
    for kind in MountKind:
        if kind_mounts := facts.dir_mounts.get(kind):
            joined = ", ".join(f"`{kind_mount}`" for kind_mount in kind_mounts)
            filesystem_note.append(f"  - {kind.spec.agent_description}: {joined}")

    bullets = ["\n".join(filesystem_note)]
    if facts.handoff_dir is not None:
        bullets.append(
            f"""Documents meant to persist across sessions (handoff notes, plan files, etc.) are in `{facts.handoff_dir}` (the user may refer to this path as the "handoff" directory); write them there.""",
        )
    if facts.review_dir is not None:
        bullets.append(
            f"""Code reviews are in `{facts.review_dir}` (the user may refer to this path as the "review" directory), written there by the user and by review agents.""",
        )
    if facts.exchange_dir is not None:
        bullets.append(
            f"""If you need to share other files with the user that don't belong in the repository (ie. logs, captures, generated reports), place them under `{facts.exchange_dir}` (the user may refer to this path as the "shared" or "exchange" directory), and show the absolute path of the files to the user, so it is easier to copy.""",
        )
    if facts.has_unjaild:
        bullets.append("`xdg-open` is available to open files or URLs for the user.")
    if facts.has_proxy:
        bullets.append(
            "`gh` is available and authenticated; use it to read and search GitHub.",
        )
    if facts.jj_bin is not None:
        bullets.append(
            f"`jj` resolves to `{SANDBOX_BIN_DIR / 'jj'}`, a wrapper adding `--ignore-working-copy`: use it for read-only queries in this repository. Any command that writes, or that targets another repository, must be run with `{facts.jj_bin}`.",
        )

    sandbox_section = f"{GLOBAL_AGENTS_MD_INTRO}\n" + "\n".join(
        f"- {bullet}" for bullet in bullets
    )
    user_paths = (
        XDG_CONFIG_HOME / "agents/AGENTS.md",
        XDG_CONFIG_HOME / f"agents/AGENTS.{agent}.md",
    )
    sections = [
        *(
            instructions
            for path in user_paths
            if (instructions := read_instructions(path)) is not None
        ),
        sandbox_section,
    ]
    body = "\n\n".join(sections)
    return f"{body}\n".encode()


def resolve_extra_agents(launched_agent: str) -> dict[str, Path]:
    """Map each installed always-provisioned agent other than the launched one to its binary."""
    resolved: dict[str, Path] = {}
    for name, spec in AGENTS.items():
        binary = next(
            (path for path in spec.provision_always if os.access(path, os.X_OK)), None
        )
        if (name != launched_agent) and (binary is not None):
            resolved[name] = binary
    return resolved


