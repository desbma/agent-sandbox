# global dynamically generated AGENTS.md
GLOBAL_AGENTS_MD_INTRO = """## Sandbox environment

You are running in a `bwrap` based sandbox.

- Do not attempt to directly run commands that require privileges (`sudo`, `su`, etc.), they would fail. If you need to do so, use the `agent-microvm` skill.
- You have unrestricted network access."""
# filesystem-bullet sublist entries, keyed by mount kind, in display order
MOUNT_KIND_DESCRIPTIONS = {
    MountKind.TMPFS: "tmpfs filesystems (paths under these can not be accessed outside of the sandbox by the user, unless under a deeper mount point; they may also be cleared if the agent is restarted)",
    MountKind.OVERLAYFS: "overlayfs filesystems (your sandbox inherits their content on startup, but changes are not reflected outside of the sandbox)",
    MountKind.BIND_RO: "read-only bind mounts",
    MountKind.BIND_RW: "normal bind mounts (allowing writes, reflected outside of the sandbox)",
}
GLOBAL_AGENTS_MD = {
    "amp": HOME / ".config/amp/AGENTS.md",
    "claude": HOME / ".claude/CLAUDE.md",
    "codex": HOME / ".codex/AGENTS.md",
    "pi": HOME / ".pi/agent/AGENTS.md",
}

# tools to expose in sandbox, even if not under /usr
HOME_TOOLS = [
    *([editor] if (editor := os.environ.get("EDITOR")) is not None else []),
    "bat",
    "chezmoi",
    "fd",
    "jj",
    "ruff",
    "rumdl",
    "ty",
    "uv",
    "uvx",
]

# per-agent extra mounts
AGENT_MOUNTS: dict[str, list[Mount]] = {
    "amp": [
        Mount(XDG_CACHE_HOME / "amp", HOME / ".amp", MountKind.BIND_RW),
        Mount(
            XDG_CONFIG_HOME / "agents/skills",
