        *(("bash",) if DEBUG else args),
    ]

    pasta_args = [*PASTA_ARGS, str(os.getpid())]
    if DEBUG:
        sys.stderr.write(f"{shlex.join(pasta_args)}\n{shlex.join(bwrap_args)}\n")
    enter_network_namespace(pasta_args)
    os.execv("/usr/bin/bwrap", bwrap_args)
