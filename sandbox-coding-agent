# symlinks in sandbox
SYMLINKS = {
    Path("/usr/bin"): Path("/bin"),
    Path("/usr/lib"): Path("/lib"),
    Path("/usr/lib64"): Path("/lib64"),
    Path("/usr/sbin"): Path("/sbin"),
    Path("/tmp"): Path("/var/tmp"),
}
AGENT_SYMLINKS = {
    "claude": {
        CWD / "AGENTS.md": CWD / "CLAUDE.md",
    },
}

# env
SANDBOX_BIN_DIR = Path("/run/bin")
ENV_SET = {
    "PATH": ":".join(
        (
            str(SANDBOX_BIN_DIR),
            str(HOME / ".local/libexec/agents"),
            str(HOME / ".cargo/bin"),
            str(HOME / ".local/bin"),
            "/usr/bin",
        ),
    ),
    "PS1": f"{AGENT}-sandbox$ ",
    "UV_LINK_MODE": "copy",
}
ENV_FORWARD = [
    "COLORTERM",
    "EDITOR",
    "HOME",
    "PYTHONPYCACHEPREFIX",
    "RUFF_CACHE_DIR",
    "RUMDL_CACHE_DIR",
    "TERM",
    "XDG_RUNTIME_DIR",
]

# groups to copy from host in sandbox
GROUPS = ["kvm", "nobody", "nogroup"]


if __name__ == "__main__":
    args = sys.argv[1:]
    bwrap_args = [
        "bwrap",
        "--unshare-all",
        "--share-net",
        "--dev",
        "/dev",
        "--dev-bind",
        "/dev/kvm",
        "/dev/kvm",
        "--proc",
        "/proc",
    ]

    # static mounts
    mounts = list(MOUNTS) + AGENT_MOUNTS.get(AGENT, [])

    # jujutsu default workspace
    jj_default_ws_root = get_jj_default_ws_root()
    if (jj_default_ws_root is not None) and not CWD.is_relative_to(jj_default_ws_root):
        for subdir in [".jj", ".git"]:
            mounts.append(Mount(jj_default_ws_root / subdir, None, MountKind.BIND_RO))

    # bind target binary
    agent_bin = shutil.which(sys.argv[1])
    assert agent_bin is not None
    agent_bin = Path(agent_bin)
    if not agent_bin.is_relative_to("/usr"):
        mounts.append(Mount(agent_bin, None, MountKind.BIND_RO))

    # exchange dir in /run
    if not CWD.is_relative_to("/tmp"):
        exchange_dir = XDG_RUNTIME_DIR / "-".join(
            p.lower() for p in (AGENT, *CWD.parts[-2:])
        )
        exchange_dir.mkdir(parents=True, exist_ok=True)
        mounts.append(Mount(exchange_dir, None, MountKind.BIND_RW))
    else:
        exchange_dir = None

    # tools to expose, even if not under /usr
    for tool_name in HOME_TOOLS:
        tool = Path(tool_name)
        if not tool.is_absolute():
            resolved = shutil.which(tool_name)
            if resolved is None:
                continue
            tool = Path(resolved)
        if not tool.exists() or tool.is_relative_to("/usr"):
            continue
        mounts.append(Mount(tool, None, MountKind.BIND_RO))

    # tmpfs over Cargo target dir to avoid build files being invalidated
    # by different sandbox env
    target_dir = CWD / "target"
    if (CWD / "Cargo.toml").is_file() and target_dir.is_dir():
        mounts.append(Mount(target_dir, None, MountKind.TMPFS))

    # xdg-open
    unjail_xdg = shutil.which("unjail-xdg-open")
    unjail = shutil.which("unjail")
    if (unjail_xdg is not None) and (unjail is not None):
        mounts += [
            Mount(Path(unjail_xdg), SANDBOX_BIN_DIR / "xdg-open", MountKind.BIND_RO),
            Mount(Path(unjail), SANDBOX_BIN_DIR / "unjail", MountKind.BIND_RO),
            Mount(XDG_RUNTIME_DIR / "unjaild/xdg-open", None, MountKind.BIND_RO),
        ]

    # auth-injecting proxy
    proxy = proxy_setup()
    if proxy is None:
        proxy_env: dict[str, str] = {}
    else:
        proxy_mount, proxy_env = proxy
        mounts.append(proxy_mount)

    # build mount arguments, shortest target path first to avoid shadowing
    mounts.sort(key=lambda m: (len(m.target.parts), m.target.parts))
    dir_mounts = collections.defaultdict(list)
    for mount in mounts:
        target = mount.target
        if mount.kind is MountKind.TMPFS:
            if not target.is_dir():
                continue
            bwrap_args += ["--perms", "0700", "--tmpfs", str(target)]
        elif mount.kind is MountKind.BIND_RO:
            if not mount.src.exists():
                continue
            bwrap_args += ["--ro-bind", str(mount.src), str(target)]
        elif mount.kind is MountKind.BIND_RW:
            if not mount.src.exists():
                # needed for agent dirs on first launch
                mount.src.mkdir()
            bwrap_args += ["--bind", str(mount.src), str(target)]
        elif mount.kind is MountKind.OVERLAYFS:
            if not mount.src.exists():
                continue
            bwrap_args += [
                "--dir",
                str(target),
                "--overlay-src",
                str(mount.src),
                "--tmp-overlay",
                str(target),
            ]
        if mount.src.is_dir():
            dir_mounts[mount.kind].append(target)

    # generated files
    files = {
        Path("/etc/group"): File(gen_group()),
        Path("/etc/nsswitch.conf"): File(
            b"passwd: files\ngroup: files\nhosts: files dns\n"
        ),
        Path("/etc/passwd"): File(gen_passwd()),
        # add a small jujutsu wrapper that runs the next resolved jj with --ignore-working-copy (read-only)
        SANDBOX_BIN_DIR / "jj": File(
            b'#!/bin/bash\nexec $(type -aP -- jj | uniq | tail -n +2 | head -n 1) --ignore-working-copy "$@"\n',
            executable=True,
        ),
    }
    try:
        global_agents_md_path = GLOBAL_AGENTS_MD[AGENT]
    except KeyError:
        pass
    else:
        files[global_agents_md_path] = File(
            gen_global_agents_md(
                exchange_dir,
                has_unjaild=(unjail_xdg is not None) and (unjail is not None),
                has_proxy=proxy is not None,
                dir_mounts=dir_mounts,
            )
        )
    if AGENT == "codex":
        # avoid "do you trust this directory?" prompt
        with (XDG_CONFIG_HOME / "codex/config.toml").open("rt") as f:
            files[HOME / ".codex/config.toml"] = File(
                f'{f.read()}\n[projects."{CWD!s}"]\ntrust_level = "trusted"\n'.encode()
            )
    elif AGENT == "pi":
        # pi needs to have persistent npm modules fo its extensions
        files[HOME / ".npmrc"] = File(f"prefix={HOME / '.pi/agent/npm'!s}\n".encode())
    for path, file in files.items():
        fd = memfd_data(file.data)
        # bwrap defaults --ro-bind-data to mode 0600, so only override for executables
        if file.executable:
            bwrap_args += ["--perms", "0700"]
        bwrap_args += ["--ro-bind-data", str(fd), str(path)]

    # symlinks
    for target, link in (SYMLINKS | AGENT_SYMLINKS.get(AGENT, {})).items():
        if target.exists():
            bwrap_args += ["--symlink", str(target), str(link)]

    # env
    bwrap_args.append("--clearenv")
    for env_k, env_v in (ENV_SET | proxy_env).items():
        bwrap_args += ["--setenv", env_k, env_v]
    for env_k in ENV_FORWARD + [
        k for k in os.environ if k.startswith(f"{AGENT.upper()}_")
    ]:
        env_v = os.environ.get(env_k)
        if env_v is not None:
            bwrap_args += ["--setenv", env_k, env_v]

    bwrap_args += [
        "--chdir",
        str(CWD),
        # "--new-session",
        "--die-with-parent",
        "--",
        *(("bash",) if DEBUG else args),
    ]

    if DEBUG:
        sys.stderr.write(shlex.join(bwrap_args) + "\n")
    os.execv("/usr/bin/bwrap", bwrap_args)
