if __name__ == "__main__":
    args = sys.argv[1:]
    bwrap_args = list(BWRAP_BASE_ARGS)

    # agents provisioned in the sandbox: the launched one and any installed always-on extra
    extras = resolve_extra_agents(AGENT)
    entry = AGENTS.get(AGENT, AgentSpec())
    agents = {AGENT: entry} | {name: AGENTS[name] for name in extras}

    # exchange dir in /run, shared across a jj repo's workspaces
    exchange_dir = (
        None
        if SCRATCH_MODE
        else exchange_dir_path(XDG_RUNTIME_DIR, exchange_root(CWD, REPO_INFO))
    )

    # static mounts plus every conditional one, deduplicated and ordered for bwrap
    mounts = resolve_mounts(
        [
            *MOUNTS,
            *(mount for spec in agents.values() for mount in spec.mounts),
            *agent_binary_mounts(agents, extras),
            *exchange_mounts(exchange_dir),
            *(session_tmpfs_mounts(agents.values()) if SCRATCH_MODE else []),
            *tool_mounts(),
            *cargo_target_mounts(),
            *UNJAIL_MOUNTS,
            *PROXY_MOUNTS,
        ],
        CWD,
    )

    dir_mounts: dict[MountKind, list[Path]] = collections.defaultdict(list)
    for mount in mounts:
        pre_check = mount.kind.spec.source_pre_check
        # NB: an existing source may be a file
        if (pre_check is SourcePreCheck.DROP_IF_MISSING) and not mount.src.exists():
            continue
        if (pre_check is SourcePreCheck.MKDIR_IF_MISSING) and not mount.src.exists():
            # needed for agent dirs on first launch
            mount.src.mkdir()
        bwrap_args += mount.bwrap_args
        if (mount.kind is MountKind.TMPFS) or mount.src.is_dir():
            dir_mounts[mount.kind].append(mount.target)

    # generated files
    files = dict(FILES)
    cpu_topology = gen_cpu_topology()
    if cpu_topology is not None:
        files[CPU_TOPOLOGY_PATH] = File(cpu_topology)
    sandbox_facts = SandboxFacts(
        exchange_dir=exchange_dir,
        dir_mounts=dir_mounts,
        has_unjaild=bool(UNJAIL_MOUNTS),
        has_proxy=PROXY_ACTIVE,
        jj_bin=JJ_BIN if IN_JJ_WORKSPACE else None,
    )
    for name, spec in agents.items():
        if spec.agents_md is not None:
            files[spec.agents_md] = File(gen_global_agents_md(name, sandbox_facts))
        files |= spec.files
    for path, file in files.items():
        fd = memfd_data(file.data)
        # bwrap defaults --ro-bind-data to mode 0600, so only override for executables
        if file.executable:
            bwrap_args += ["--perms", "0700"]
        bwrap_args += ["--ro-bind-data", str(fd), str(path)]

    # symlinks
    for target, link in (SYMLINKS | dict(entry.symlinks)).items():
        if target.exists():
            bwrap_args += ["--symlink", str(target), str(link)]

    # env
    forwarded = {
        env_k: os.environ[env_k]
        for env_k in ENV_FORWARD
        + [k for k in os.environ if k.startswith(f"{AGENT.upper()}_")]
        if env_k in os.environ
    }
    bwrap_args.append("--clearenv")
    # forwarded last: a host value overrides what the sandbox sets for the same variable
    for env_k, env_v in (ENV_SET | PROXY_ENV | entry.env | forwarded).items():
        bwrap_args += ["--setenv", env_k, env_v]

    bwrap_args += [
        "--chdir",
        str(CWD),
        "--die-with-parent",
        "--",
        *(("bash",) if DEBUG else args),
    ]

    if DEBUG:
        sys.stderr.write(shlex.join(bwrap_args) + "\n")
    os.execv("/usr/bin/bwrap", bwrap_args)
